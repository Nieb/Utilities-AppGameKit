//##############################################################################################################################################################
//##############################################################################################################################################################
TYPE Vec2
    x AS FLOAT
    y AS FLOAT
ENDTYPE

FUNCTION vec2(X AS FLOAT, Y AS FLOAT)
    Result AS Vec2
    Result.x = X
    Result.y = Y
ENDFUNCTION Result

//==============================================================================================================================================================
TYPE iVec2
    x AS INTEGER
    y AS INTEGER
ENDTYPE

FUNCTION ivec2(X AS INTEGER, Y AS INTEGER)
    Result AS iVec2
    Result.x = X
    Result.y = Y
ENDFUNCTION Result

//==============================================================================================================================================================
FUNCTION InitializeVector2()
    //  AGK does not support default values for UserTypes.
    GLOBAL Zero2    AS Vec2: Zero2    = vec2(0.0, 0.0)
    GLOBAL Axis2_X  AS Vec2: Axis2_X  = vec2(1.0, 0.0)
    GLOBAL Axis2_Y  AS Vec2: Axis2_Y  = vec2(0.0, 1.0)
    GLOBAL Axis2_XY AS Vec2: Axis2_XY = vec2(Sqrt2Rcp, Sqrt2Rcp)
ENDFUNCTION

//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                    Arithmetic Operators
FUNCTION add2( A AS Vec2, B REF AS Vec2):  A.x=(A.x+B.x)  :  A.y=(A.y+B.y)  :ENDFUNCTION A
FUNCTION add2f(A AS Vec2, B    AS FLOAT):  A.x=(A.x+B  )  :  A.y=(A.y+B  )  :ENDFUNCTION A

FUNCTION sub2( A AS Vec2, B REF AS Vec2):  A.x=(A.x-B.x)  :  A.y=(A.y-B.y)  :ENDFUNCTION A
FUNCTION sub2f(A AS Vec2, B    AS FLOAT):  A.x=(A.x-B  )  :  A.y=(A.y-B  )  :ENDFUNCTION A

FUNCTION mul2( A AS Vec2, B REF AS Vec2):  A.x=(A.x*B.x)  :  A.y=(A.y*B.y)  :ENDFUNCTION A
FUNCTION mul2f(A AS Vec2, B    AS FLOAT):  A.x=(A.x*B  )  :  A.y=(A.y*B  )  :ENDFUNCTION A

FUNCTION div2( A AS Vec2, B REF AS Vec2):  A.x=(A.x/B.x)  :  A.y=(A.y/B.y)  :ENDFUNCTION A
FUNCTION div2f(A AS Vec2, B    AS FLOAT):  A.x=(A.x/B  )  :  A.y=(A.y/B  )  :ENDFUNCTION A

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                       "Dot" Product
FUNCTION dot2(A REF AS Vec2, B REF AS Vec2):ENDFUNCTION (A.x*B.x + A.y*B.y)

//==============================================================================================================================================================
//                                                                      "Cross" Product
FUNCTION crs2(A REF AS Vec2, B REF AS Vec2):ENDFUNCTION (A.x*B.y - A.y*B.x)

//##############################################################################################################################################################
//##############################################################################################################################################################
FUNCTION inv2(A AS Vec2):  A.x=(-A.x   ) : A.y=(-A.y   )  :ENDFUNCTION A        //  "Invert"        Additive Inverse            AKA: Negation

FUNCTION cmp2(A AS Vec2):  A.x=(1.0-A.x) : A.y=(1.0-A.y)  :ENDFUNCTION A        //  "Complement"    Complimentary Inverse

FUNCTION rcp2(A AS Vec2):  A.x=(1.0/A.x) : A.y=(1.0/A.y)  :ENDFUNCTION A        //  "Reciprocal"    Multiplicative Inverse

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                          "Length"                AKA: Distance from (0,0,0)
FUNCTION len2(A AS Vec2)
    A.x = sqrt(A.x*A.x + A.y*A.y)
ENDFUNCTION A.x

//==============================================================================================================================================================
//                                                                         "Distance"
FUNCTION dst2(A AS Vec2, B REF AS Vec2)
    A.x = B.x-A.x
    A.y = B.y-A.y
    A.x = sqrt(A.x*A.x + A.y*A.y)
ENDFUNCTION A.x

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                         "Lengthen"               'A' scaled to 'LengthNew'.
FUNCTION lenthn2(A AS Vec2, LengthNew AS FLOAT)
    IF NOT (A.x = 0.0 AND A.y = 0.0) //  Avoid Divide-by-Zero.
        LengthNew = LengthNew / sqrt(A.x*A.x + A.y*A.y)
        A.x = A.x * LengthNew
        A.y = A.y * LengthNew
    ENDIF
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                        "Normalize"               'A' scaled to length of 1.0.
FUNCTION nrm2(A AS Vec2)
    IF NOT (A.x = 0.0 AND A.y = 0.0) //  Avoid Divide-by-Zero.
        Length AS FLOAT: Length = 1.0/sqrt(A.x*A.x + A.y*A.y)
        A.x = A.x*Length
        A.y = A.y*Length
    ENDIF
ENDFUNCTION A

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                           "Floor"                Each component rounded down.
FUNCTION flr2(A AS Vec2)
    A.x = floor(A.x)
    A.y = floor(A.y)
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                          "Ceiling"               Each component rounded up.
FUNCTION cil2(A AS Vec2)
    A.x = ceil(A.x)
    A.y = ceil(A.y)
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                           "Round"                Each component rounded to nearest Integer.
FUNCTION rnd2(A AS Vec2)
    A.x = round(A.x)
    A.y = round(A.y)
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                         "Round To"               Each component rounded to nearest multiple of 'RoundTo'.
FUNCTION rndto2(A REF AS Vec2, RoundTo AS FLOAT)
    Result AS Vec2
    Result.x = fmod(A.x, RoundTo)
    Result.y = fmod(A.y, RoundTo)
    Threshold AS FLOAT: Threshold = RoundTo * 0.5
    IF     Result.x > 0.0 : IF (Result.x >  Threshold) : Result.x = A.x + (RoundTo -     Result.x ) : ELSE : Result.x = A.x -     Result.x  : ENDIF
    ELSEIF Result.x < 0.0 : IF (Result.x < -Threshold) : Result.x = A.x - (RoundTo - abs(Result.x)) : ELSE : Result.x = A.x + abs(Result.x) : ENDIF
    ELSE : Result.x = A.x
    ENDIF
    IF     Result.y > 0.0 : IF (Result.y >  Threshold) : Result.y = A.y + (RoundTo -     Result.y ) : ELSE : Result.y = A.y -     Result.y  : ENDIF
    ELSEIF Result.y < 0.0 : IF (Result.y < -Threshold) : Result.y = A.y - (RoundTo - abs(Result.y)) : ELSE : Result.y = A.y + abs(Result.y) : ENDIF
    ELSE : Result.y = A.y
    ENDIF
ENDFUNCTION Result

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                      "Average" of 2
FUNCTION avg2_2(A AS Vec2, B REF AS Vec2)
    A.x = (A.x + B.x) * 0.5
    A.y = (A.y + B.y) * 0.5
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                      "Average" of 3
FUNCTION avg2_3(A AS Vec2, B REF AS Vec2, C REF AS Vec2)
    A.x = (A.x + B.x + C.x) * OneThird
    A.y = (A.y + B.y + C.y) * OneThird
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                      "Average" of 4
FUNCTION avg2_4(A AS Vec2, B REF AS Vec2, C REF AS Vec2, D REF AS Vec2)
    A.x = (A.x + B.x + C.x + D.x) * 0.25
    A.y = (A.y + B.y + C.y + D.y) * 0.25
ENDFUNCTION A

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                         "Reflect"
FUNCTION ref2(A AS Vec2, Sn REF AS Vec2)
    Dot AS FLOAT: Dot = (A.x * Sn.x) + (A.y * Sn.y)
    A.x = A.x + (Sn.x * Dot * -2.0)
    A.y = A.y + (Sn.y * Dot * -2.0)
ENDFUNCTION A

//==============================================================================================================================================================
//                                                                         "Deflect"
FUNCTION def2(A AS Vec2, Sn REF AS Vec2)
    Dot AS FLOAT: Dot = (A.x * Sn.x) + (A.y * Sn.y)
    A.x = (Sn.x * Dot * 2.0) - A.x
    A.y = (Sn.y * Dot * 2.0) - A.y
ENDFUNCTION A

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                        "Projection"              Get ClosestPointOnLine.
//
//      prj3(  Point,  Line-PointA,  Line-PointB  )
//
FUNCTION prj2(P AS Vec2, La REF AS Vec2, Lb REF AS Vec2)
    dAP_X AS FLOAT: dAP_X =  P.x - La.x
    dAP_Y AS FLOAT: dAP_Y =  P.y - La.y
    dAB_X AS FLOAT: dAB_X = Lb.x - La.x
    dAB_Y AS FLOAT: dAB_Y = Lb.y - La.y

    DotAP_AB AS FLOAT: DotAP_AB = (dAP_X * dAB_X) + (dAP_Y * dAB_Y)
    DotAB_AB AS FLOAT: DotAB_AB = (dAB_X * dAB_X) + (dAB_Y * dAB_Y) //  Squared length of DltAB.

    // Get distance to NearestPointOnLine, from 'La' as multiple of 'dAB':
    Scaler AS FLOAT: Scaler = DotAP_AB / DotAB_AB

    P.x = La.x + (dAB_X * Scaler)
    P.y = La.y + (dAB_Y * Scaler)
ENDFUNCTION P

//==============================================================================================================================================================
//
//      prj3n(  Point,  Line-Position,  Line-Normal  )
//
FUNCTION prj2n(P AS Vec2, Lp REF AS Vec2, Ln REF AS Vec2)
    Scaler AS FLOAT: Scaler = ((P.x-Lp.x) * Ln.x) + ((P.y-Lp.y) * Ln.y)
    P.x = Lp.x + (Ln.x * Scaler)
    P.y = Lp.y + (Ln.y * Scaler)
ENDFUNCTION P

//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
FUNCTION FromAngle(Theta AS FLOAT)
    Theta = -Theta // Theta is clockwise.
    Result AS Vec2
    Result.x = cos(Theta)
    Result.y = sin(Theta)
ENDFUNCTION Result

//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                       "Rotate Left"
//
//  Rotate 90 degrees Anti-Clockwise.
//
FUNCTION rotl2(A REF AS Vec2)
    Result AS Vec2
    Result.x = -A.y
    Result.y =  A.x
ENDFUNCTION Result

//==============================================================================================================================================================
//                                                                       "Rotate Right"
//
//   Rotate 90 degrees Clockwise.
//
FUNCTION rotr2(A REF AS Vec2)
    Result AS Vec2
    Result.x =  A.y
    Result.y = -A.x
ENDFUNCTION Result

//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                          "Rotate"
//
//  'Point' around Pivot(0,0).
//
FUNCTION rot2(P REF AS Vec2, Theta AS FLOAT)
    Theta = -Theta // Theta is clockwise.

    CosT AS FLOAT: CosT = cos(Theta)
    SinT AS FLOAT: SinT = sin(Theta)

    Result AS Vec2
    Result.x = P.x*CosT - P.y*SinT
    Result.y = P.x*SinT + P.y*CosT
ENDFUNCTION Result

//==============================================================================================================================================================
//                                                                          "Rotate"
//
//  'Point' around 'Pivot'.
//
//      rot2p(  Point,  Pivot,  Theta  )
//
FUNCTION rot2p(P REF AS Vec2, V REF AS Vec2, Theta AS FLOAT)
    Theta = -Theta // Theta is clockwise.

    dX AS FLOAT: dX = P.x - V.x
    dY AS FLOAT: dY = P.y - V.y

    CosT AS FLOAT: CosT = cos(Theta)
    SinT AS FLOAT: SinT = sin(Theta)

    Result AS Vec2
    Result.x = V.x  +  dX*CosT - dY*SinT
    Result.y = V.y  +  dX*SinT + dY*CosT
ENDFUNCTION Result
