//##############################################################################################################################################################
//##############################################################################################################################################################
TYPE vec4
    x AS FLOAT
    y AS FLOAT
    z AS FLOAT
    w AS FLOAT
ENDTYPE

FUNCTION vec4(X AS FLOAT, Y AS FLOAT, Z AS FLOAT, W AS FLOAT)
    Result AS vec4
    Result.x = X
    Result.y = Y
    Result.z = Z
    Result.w = W
ENDFUNCTION Result

//==============================================================================================================================================================
TYPE ivec4
    x AS INTEGER
    y AS INTEGER
    z AS INTEGER
    w AS INTEGER
ENDTYPE

FUNCTION ivec4(X AS INTEGER, Y AS INTEGER, Z AS INTEGER, W AS INTEGER)
    Result AS ivec4
    Result.x = X
    Result.y = Y
    Result.z = Z
    Result.w = W
ENDFUNCTION Result

//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                    Arithmetic Operators
FUNCTION add4( A AS vec4, B REF AS vec4):  A.x=(A.x+B.x)  :  A.y=(A.y+B.y)  :  A.z=(A.z+B.z)  :  A.w=(A.w+B.w)  :ENDFUNCTION A
FUNCTION add4f(A AS vec4, B    AS FLOAT):  A.x=(A.x+B  )  :  A.y=(A.y+B  )  :  A.z=(A.z+B  )  :  A.w=(A.w+B  )  :ENDFUNCTION A

FUNCTION sub4( A AS vec4, B REF AS vec4):  A.x=(A.x-B.x)  :  A.y=(A.y-B.y)  :  A.z=(A.z-B.z)  :  A.w=(A.w-B.w)  :ENDFUNCTION A
FUNCTION sub4f(A AS vec4, B    AS FLOAT):  A.x=(A.x-B  )  :  A.y=(A.y-B  )  :  A.z=(A.z-B  )  :  A.w=(A.w-B  )  :ENDFUNCTION A

FUNCTION mul4( A AS vec4, B REF AS vec4):  A.x=(A.x*B.x)  :  A.y=(A.y*B.y)  :  A.z=(A.z*B.z)  :  A.w=(A.w*B.w)  :ENDFUNCTION A
FUNCTION mul4f(A AS vec4, B    AS FLOAT):  A.x=(A.x*B  )  :  A.y=(A.y*B  )  :  A.z=(A.z*B  )  :  A.w=(A.w*B  )  :ENDFUNCTION A

FUNCTION div4( A AS vec4, B REF AS vec4):  A.x=(A.x/B.x)  :  A.y=(A.y/B.y)  :  A.z=(A.z/B.z)  :  A.w=(A.w/B.w)  :ENDFUNCTION A
FUNCTION div4f(A AS vec4, B    AS FLOAT):  A.x=(A.x/B  )  :  A.y=(A.y/B  )  :  A.z=(A.z/B  )  :  A.w=(A.w/B  )  :ENDFUNCTION A

//##############################################################################################################################################################
//##############################################################################################################################################################
//                                                                       "Dot" Product
FUNCTION dot4(A REF AS vec4, B REF AS vec4):ENDFUNCTION (A.x*B.x + A.y*B.y + A.z*B.z + A.w*B.w)
